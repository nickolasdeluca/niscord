import { AboutSlint, Button, LineEdit, ListView, Palette } from "std-widgets.slint";
import { SharePicker, SourceItem } from "picker.slint";
import { Stage, StreamTile } from "stage.slint";
import { SettingsDialog } from "settings.slint";
export { StreamWindow } from "popout.slint";

export { SourceItem, StreamTile }

export struct PeerItem {
    id: string,
    name: string,
    initial: string,
    is-me: bool,
    live: bool,
    share-title: string,
    share-is-window: bool,
    viewer-count: int,
    // Whether the local user is watching this peer.
    watching: bool,
}

component Avatar inherits Rectangle {
    in property <string> initial;
    in property <bool> live;
    width: 36px;
    height: 36px;
    border-radius: self.width / 2;
    background: #5865f2;
    border-width: root.live ? 2px : 0px;
    border-color: #ed4245;
    Text {
        text: root.initial;
        color: white;
        font-weight: 700;
        font-size: 16px;
    }
}

component LiveBadge inherits Rectangle {
    background: #ed4245;
    border-radius: 3px;
    width: label.preferred-width + 8px;
    height: label.preferred-height + 2px;
    label := Text {
        text: "LIVE";
        color: white;
        font-size: 10px;
        font-weight: 800;
    }
}

component PeerRow inherits Rectangle {
    in property <PeerItem> peer;
    callback watch();
    callback unwatch();

    height: layout.preferred-height;
    border-radius: 6px;
    background: touch.has-hover ? Palette.alternate-background.brighter(0.15) : transparent;
    touch := TouchArea { }

    layout := HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        Avatar {
            initial: root.peer.initial;
            live: root.peer.live;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.peer.name;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.peer.is-me: Text {
                    text: "(you)";
                    color: Palette.foreground.transparentize(0.5);
                }
                if root.peer.live: LiveBadge { }
            }
            if root.peer.live: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: (root.peer.share-is-window ? "Window: " : "Screen: ") + root.peer.share-title;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.4);
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.peer.viewer-count > 0: Text {
                    text: root.peer.viewer-count + " watching";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.4);
                }
            }
        }
        if root.peer.live && !root.peer.is-me: Button {
            text: root.peer.watching ? "Stop" : "Watch";
            primary: !root.peer.watching;
            clicked => {
                if root.peer.watching {
                    root.unwatch();
                } else {
                    root.watch();
                }
            }
        }
    }
}

component ConnectScreen inherits Rectangle {
    in-out property <string> server-url;
    in-out property <string> display-name;
    in-out property <string> password;
    in property <bool> connecting;
    in property <string> error;
    callback connect();
    callback about();

    init => {
        server-edit.focus();
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 380px;
                background: Palette.alternate-background;
                border-radius: 10px;
                VerticalLayout {
                    padding: 28px;
                    spacing: 10px;
                    Text {
                        text: "Niscord";
                        font-size: 28px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Share your screen with friends";
                        horizontal-alignment: center;
                        color: Palette.foreground.transparentize(0.4);
                    }
                    Rectangle { height: 8px; }
                    Text { text: "Server"; font-size: 12px; }
                    server-edit := LineEdit {
                        text <=> root.server-url;
                        placeholder-text: "ws://your-server:8080";
                        enabled: !root.connecting;
                        accepted => { root.connect(); }
                    }
                    Text { text: "Display name"; font-size: 12px; }
                    LineEdit {
                        text <=> root.display-name;
                        placeholder-text: "How friends will see you";
                        enabled: !root.connecting;
                        accepted => { root.connect(); }
                    }
                    Text { text: "Server password"; font-size: 12px; }
                    LineEdit {
                        text <=> root.password;
                        input-type: InputType.password;
                        placeholder-text: "Leave empty if none";
                        enabled: !root.connecting;
                        accepted => { root.connect(); }
                    }
                    if root.error != "": Text {
                        text: root.error;
                        color: #ed4245;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 4px; }
                    Button {
                        text: root.connecting ? "Connecting…" : "Connect";
                        primary: true;
                        enabled: !root.connecting;
                        clicked => { root.connect(); }
                    }
                    Button {
                        text: "About";
                        clicked => { root.about(); }
                    }
                }
            }
        }
    }
}

component MainScreen inherits Rectangle {
    in property <[PeerItem]> peers;
    in property <string> my-name;
    in property <bool> online;
    in property <string> status-text;
    in property <bool> sharing;
    in property <[StreamTile]> tiles;
    in-out property <string> focused;
    in property <bool> preview-hidden;
    in property <int> popped-count;
    // A downloaded update waiting for a restart ("0.2.0"), or empty.
    in property <string> update-version;
    callback watch(string);
    callback unwatch(string);
    callback share();
    callback stop-share();
    callback close-stream(string);
    callback retry-stream(string);
    callback set-volume(string, float);
    callback toggle-mute(string);
    callback disconnect();
    callback about();
    callback open-settings();
    callback pop-out(string);
    callback hide-preview();
    callback show-preview();
    callback restart-to-update();

    HorizontalLayout {
        // Sidebar: who is online.
        Rectangle {
            width: 300px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: "ONLINE — " + root.peers.length;
                    font-size: 12px;
                    font-weight: 700;
                    color: Palette.foreground.transparentize(0.4);
                }
                ListView {
                    vertical-stretch: 1;
                    for peer in root.peers: PeerRow {
                        peer: peer;
                        watch => { root.watch(peer.id); }
                        unwatch => { root.unwatch(peer.id); }
                    }
                }
                if root.update-version != "": Rectangle {
                    background: #3ba55d33;
                    border-color: #3ba55d;
                    border-width: 1px;
                    border-radius: 8px;
                    height: update-row.preferred-height;
                    update-row := HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Text {
                            text: "Niscord " + root.update-version + " is ready to install.";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        Button {
                            text: "Restart";
                            primary: true;
                            clicked => { root.restart-to-update(); }
                        }
                    }
                }
                // Local user panel.
                Rectangle {
                    background: Palette.background.darker(0.1);
                    border-radius: 8px;
                    height: panel.preferred-height;
                    panel := VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: root.online ? #3ba55d : #faa61a;
                            }
                            VerticalLayout {
                                Text { text: root.my-name; font-weight: 600; overflow: elide; }
                                Text {
                                    text: root.status-text;
                                    font-size: 11px;
                                    color: Palette.foreground.transparentize(0.4);
                                    overflow: elide;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: root.sharing ? "Stop sharing" : "Share screen";
                                primary: !root.sharing;
                                horizontal-stretch: 1;
                                enabled: root.online || root.sharing;
                                clicked => {
                                    if root.sharing {
                                        root.stop-share();
                                    } else {
                                        root.share();
                                    }
                                }
                            }
                            Button {
                                text: "Leave";
                                clicked => { root.disconnect(); }
                            }
                        }
                        if root.sharing && root.preview-hidden: Button {
                            text: "Show my preview";
                            clicked => { root.show-preview(); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: "Settings";
                                horizontal-stretch: 1;
                                clicked => { root.open-settings(); }
                            }
                            Button {
                                text: "About";
                                horizontal-stretch: 1;
                                clicked => { root.about(); }
                            }
                        }
                    }
                }
            }
        }

        // Stage: your own stream preview and streams being watched.
        Stage {
            horizontal-stretch: 1;
            tiles: root.tiles;
            focused <=> root.focused;
            popped-count: root.popped-count;
            close(key) => { root.close-stream(key); }
            retry(key) => { root.retry-stream(key); }
            pop-out(key) => { root.pop-out(key); }
            hide-preview => { root.hide-preview(); }
            set-volume(key, value) => { root.set-volume(key, value); }
            toggle-mute(key) => { root.toggle-mute(key); }
            change-source => { root.share(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Niscord";
    icon: @image-url("../assets/icon.png");
    in property <string> version;
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 720px;
    min-height: 480px;

    // Connect form.
    in-out property <string> server-url;
    in-out property <string> display-name;
    in-out property <string> password;
    in property <bool> connecting;
    in property <string> connect-error;

    // Session.
    in property <bool> connected;
    in property <bool> online;
    in property <string> status-text;
    in property <string> my-name;
    in property <[PeerItem]> peers;
    in property <string> notice;

    // Sharing and watching.
    in property <bool> sharing;
    in property <[StreamTile]> tiles;
    in-out property <string> focused-stream;
    in property <bool> picker-open;
    in property <[SourceItem]> picker-windows;
    in property <[SourceItem]> picker-screens;
    in-out property <int> picker-selected: -1;
    in-out property <int> picker-resolution: 1;
    in-out property <int> picker-fps: 1;
    in-out property <bool> picker-audio: true;
    // Your own preview tile is hidden (you still stream).
    in property <bool> preview-hidden;
    // Streams shown in their own windows.
    in property <int> popped-count;
    in property <bool> settings-open;
    in property <string> shortcut;
    in property <bool> shortcut-recording;
    in property <string> shortcut-error;
    in-out property <bool> show-preview: true;
    in property <string> update-version;

    callback connect();
    callback disconnect();
    callback watch(string);
    callback unwatch(string);
    // Open the source picker.
    callback share();
    callback stop-share();
    callback close-stream(string);
    callback retry-stream(string);
    callback set-volume(string, float);
    callback toggle-mute(string);
    callback picker-cancel();
    callback picker-choose(int);
    callback pop-out(string);
    callback set-preview-hidden(bool);
    callback open-settings();
    callback close-settings();
    callback record-shortcut();
    callback shortcut-key(string);
    callback cancel-recording();
    callback clear-shortcut();
    callback restart-to-update();

    about-popup := PopupWindow {
        x: (root.width - 360px) / 2;
        y: (root.height - 300px) / 2;
        width: 360px;
        height: 300px;
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 10px;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text {
                    text: "Niscord";
                    font-size: 20px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Private screen sharing for friends.";
                    horizontal-alignment: center;
                }
                Text {
                    text: "Version " + root.version;
                    horizontal-alignment: center;
                    color: Palette.foreground.transparentize(0.4);
                }
                AboutSlint { }
            }
        }
    }

    if !root.connected: ConnectScreen {
        server-url <=> root.server-url;
        display-name <=> root.display-name;
        password <=> root.password;
        connecting: root.connecting;
        error: root.connect-error;
        connect => { root.connect(); }
        about => { about-popup.show(); }
    }

    if root.connected: MainScreen {
        peers: root.peers;
        my-name: root.my-name;
        online: root.online;
        status-text: root.status-text;
        sharing: root.sharing;
        tiles: root.tiles;
        focused <=> root.focused-stream;
        close-stream(key) => { root.close-stream(key); }
        retry-stream(key) => { root.retry-stream(key); }
        set-volume(key, value) => { root.set-volume(key, value); }
        toggle-mute(key) => { root.toggle-mute(key); }
        preview-hidden: root.preview-hidden;
        popped-count: root.popped-count;
        update-version: root.update-version;
        restart-to-update => { root.restart-to-update(); }
        pop-out(key) => { root.pop-out(key); }
        hide-preview => { root.set-preview-hidden(true); }
        show-preview => { root.set-preview-hidden(false); }
        open-settings => { root.open-settings(); }
        watch(id) => { root.watch(id); }
        unwatch(id) => { root.unwatch(id); }
        share => { root.share(); }
        stop-share => { root.stop-share(); }
        disconnect => { root.disconnect(); }
        about => { about-popup.show(); }
    }

    if root.connected && root.picker-open: SharePicker {
        windows: root.picker-windows;
        screens: root.picker-screens;
        sharing: root.sharing;
        selected <=> root.picker-selected;
        resolution <=> root.picker-resolution;
        fps <=> root.picker-fps;
        audio <=> root.picker-audio;
        cancel => { root.picker-cancel(); }
        choose(key) => { root.picker-choose(key); }
    }

    if root.connected && root.settings-open: SettingsDialog {
        shortcut: root.shortcut;
        recording: root.shortcut-recording;
        shortcut-error: root.shortcut-error;
        show-preview <=> root.show-preview;
        close => { root.close-settings(); }
        record-shortcut => { root.record-shortcut(); }
        shortcut-key(typed) => { root.shortcut-key(typed); }
        cancel-recording => { root.cancel-recording(); }
        clear-shortcut => { root.clear-shortcut(); }
        show-preview-changed(show) => { root.set-preview-hidden(!show); }
    }

    // Transient message banner (e.g. "coming soon", "stream ended").
    if root.notice != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: 16px;
        width: notice-text.preferred-width + 32px;
        height: notice-text.preferred-height + 16px;
        background: #202225;
        border-radius: 8px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000080;
        notice-text := Text {
            text: root.notice;
            color: white;
        }
    }
}
